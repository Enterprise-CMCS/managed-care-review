    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "@vitest/coverage-v8": "^4.1.7",
        "prettier": "^3.9.6",
        "tsx": "^4.21.0",
        "typescript": "7.0.2",
        "vitest": "^4.1.7"
    }
}
