{
    "name": "@mc-review/synthetic-data",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "build": "tsc --noEmit",
        "check:runtime": "tsx src/cli.ts --help",
        "cli": "tsx src/cli.ts",
