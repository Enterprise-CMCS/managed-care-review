{
    "$schema": "../node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript"],
    "categories": {
        "correctness": "off"
    },
    "env": {
        "builtin": true,
        "node": true
    },
    "rules": {
        "prefer-promise-reject-errors": "error",
        "no-throw-literal": "error",
        "no-unused-vars": [
            "warn",
            {
                "argsIgnorePattern": "^_*"
            }
        ]
    },
    "ignorePatterns": ["**/*.js"]
}
