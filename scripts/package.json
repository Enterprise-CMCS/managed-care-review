{
    "name": "scripts",
    "version": "1.0.0",
    "description": "local scripts",
    "main": "index.js",
    "type": "module",
    "license": "MIT",
    "private": true,
    "scripts": {
        "precommit": "lint-staged",
        "generate-client-credentials": "tsx generate-client-credentials.ts",
        "lint": "tsc --noEmit && oxlint --deny-warnings .",
        "build": "tsc",
        "build:ci-scripts": "tsc",
        "test:cognito-cleanup": "tsc --noEmit && tsx --test tests/cognito-cleanup.test.ts"
    },
    "lint-staged": {
