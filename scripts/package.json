            "oxlint --deny-warnings"
        ],
        "*.sh": [
            "shellcheck"
        ]
    },
    "dependencies": {
        "@aws-sdk/client-cloudformation": "^3.1157.0",
        "@aws-sdk/client-cloudfront": "^3.1157.0",
        "@aws-sdk/client-cognito-identity-provider": "^3.1157.0",
        "@aws-sdk/client-lambda": "^3.1157.0",
        "@aws-sdk/client-s3": "^3.1157.0",
        "@aws-sdk/client-secrets-manager": "^3.1157.0",
        "@aws-sdk/client-sts": "^3.1157.0",
        "@types/papaparse": "^5.5.2",
        "@types/uuid": "^11.0.0",
        "octokit": "^5.0.5",
        "papaparse": "^5.7.0"
    },
    "devDependencies": {
        "@octokit/action": "^8.0.4",
        "@octokit/openapi-types": "^27.0.0",
        "csv-parser": "^3.2.1",
        "lint-staged": "^17.6.0",
        "tsx": "^4.23.15",
        "typescript": "7.0.2",
        "uuid": "^14.0.3"
    }
}
