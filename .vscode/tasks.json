{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Type-check app-web",
            "type": "shell",
            "command": "pnpm",
            "args": ["--filter", "app-web", "exec", "tsc", "--noEmit"],
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "dedicated"
            },
            "problemMatcher": "$tsc"
        }
    ]
}
