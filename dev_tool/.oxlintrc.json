{
    "$schema": "../node_modules/oxlint/configuration_schema.json",
    "plugins": [],
    "categories": {
        "correctness": "off"
    },
    "env": {
        "builtin": true
    },
    "overrides": [
        {
            "files": ["**/*.ts"],
            "rules": {
                "prefer-promise-reject-errors": "error",
                "no-throw-literal": "error",
                "no-unused-vars": [
                    "warn",
                    {
                        "argsIgnorePattern": "^_*"
                    }
                ],
                "no-console": [
                    "warn",
                    {
                        "allow": [
                            "assert",
                            "clear",
                            "count",
                            "countReset",
                            "debug",
                            "dir",
                            "dirxml",
                            "error",
                            "group",
                            "groupCollapsed",
                            "groupEnd",
                            "info",
                            "profile",
                            "profileEnd",
                            "table",
                            "time",
                            "timeEnd",
                            "timeLog",
                            "timeStamp",
                            "trace",
                            "warn"
                        ]
                    }
                ]
            },
            "globals": {
                "process": "readonly",
                "Buffer": "readonly",
                "__dirname": "readonly",
                "__filename": "readonly",
                "console": "readonly",
                "global": "readonly",
                "setTimeout": "readonly",
                "clearTimeout": "readonly",
                "setInterval": "readonly",
                "clearInterval": "readonly"
            },
            "plugins": ["typescript"]
        }
    ],
    "ignorePatterns": ["*.config.js", "**/esbuild.config.js"]
}
